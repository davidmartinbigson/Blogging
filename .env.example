# ---------------------------------------------------------------------------
# Public site URL (no trailing slash). Change this after your first deploy.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=https://sageandstory.com

# ---------------------------------------------------------------------------
# Google AdSense
# Leave empty until your account is approved — ad slots stay invisible.
# Example: ca-pub-1234567890123456
# ---------------------------------------------------------------------------
NEXT_PUBLIC_ADSENSE_CLIENT=

# Ad slot IDs (create these inside your AdSense dashboard)
NEXT_PUBLIC_ADSENSE_SLOT_IN_ARTICLE=
NEXT_PUBLIC_ADSENSE_SLOT_SIDEBAR=
NEXT_PUBLIC_ADSENSE_SLOT_FOOTER=

# ---------------------------------------------------------------------------
# Analytics (optional). Add an ID to switch a provider on.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=

# ---------------------------------------------------------------------------
# Newsletter endpoint (optional). Any service that accepts a JSON POST:
# { "email": "reader@example.com" }. Leave empty to hide the form's network
# call and store nothing.
# ---------------------------------------------------------------------------
NEWSLETTER_ENDPOINT=

# Contact form destination (optional). Without it the contact page falls back
# to a mailto: link.
# ---------------------------------------------------------------------------
CONTACT_ENDPOINT=
